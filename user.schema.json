{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/user.schema.json",
  "title": "User",
  "description": "A document in the users collection.",
  "type": "object",
  "properties": {
    "uid": {
      "description": "Firebase Authentication user ID.",
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "photo_url": {
      "type": "string",
      "format": "uri"
    },
    "birthdate": { "$ref": "#/$defs/timestamp" },
    "hometown": {
      "type": "string"
    },
    "created_time": { "$ref": "#/$defs/timestamp" }
  },
  "required": ["uid", "display_name", "email", "created_time"],
  "additionalProperties": false,
  "$defs": {
    "timestamp": {
      "description": "Firestore timestamp, serialized as an RFC 3339 date-time string.",
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "uid": "5QJ30SbaohTD45Zb3DuijTbmKIxx",
      "display_name": "Casey",
      "email": "casey@mail.com",
      "photo_url": "https://firebasestorage.googleapis.com/v0/wyz",
      "birthdate": "2003-05-02T00:00:00-04:00",
      "hometown": "Someplace",
      "created_time": "2024-06-17T05:55:17-04:00"
    }
  ]
}
